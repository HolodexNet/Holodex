{
  "$schema": "http://json.schemastore.org/prettierrc",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 80,
  "useTabs": false,
  "endOfLine": "auto",
  "arrowParens": "always",
  "plugins": [
    "@prettier/plugin-oxc",
    "prettier-plugin-tailwindcss"
  ],
  "tailwindStylesheet": "./src/pure.css"
}