    "react-router-dom": "^7.18.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "iconx": "^0.2.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
